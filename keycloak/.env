# Bootstrap Admin User
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=Admin@123

# Enable HTTP
KC_HTTP_ENABLED=true

# Proxy Headers (Required for Cloudflare Tunnel)
KC_PROXY_HEADERS=xforwarded

# Public Hostname (Replace with your current Cloudflare Tunnel URL)
KC_HOSTNAME=straight-blacks-pale-asked.trycloudflare.com

# Optional Features
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
